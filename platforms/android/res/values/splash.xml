<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidX core-splashscreen: the Android 12 splash screen on every Android version (5.0+). MainActivity keeps it
     until the page has drawn, then switches to AppTheme (postSplashScreenTheme). -->
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0D0D</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
