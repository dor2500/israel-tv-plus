[Unit]
Description=Israel TV+ Dedicated Kiosk Appliance
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/home/pi/israel-tv-plus/rpi/start_kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
